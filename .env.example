APP_NAME=AgentOps Copilot
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./agentops.db

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b

VECTOR_STORE_PROVIDER=faiss
VECTOR_STORE_PATH=./data/vector_store

RUNBOOKS_PATH=./data/runbooks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

EXECUTOR_PROVIDER=simulated

# Airflow executor configuration
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=

AIRFLOW_TIMEOUT_SECONDS=10
AIRFLOW_MAX_RETRIES=3
AIRFLOW_RETRY_DELAY_SECONDS=1